<div class="wrapper">
  <div class="region prose flow text-center" style="--region-space: var(--space-xl-2xl);">
    <h1>CodiceSolidale</h1>
    <p>Scegli la lingua / Choose your language:</p>
    <div class="cluster" style="justify-content: center; gap: var(--space-s);">
      <a href="/it/" class="button" hreflang="it">🇮🇹 Italiano</a>
      <a href="/en/" class="button" hreflang="en">🇬🇧 English</a>
    </div>
  </div>
</div>

<script>
  (function () {
    const lang = (navigator.language || navigator.userLanguage || 'it').toLowerCase().slice(0, 2);
    if (lang === 'en') {
      window.location.replace('/en/');
    } else {
      window.location.replace('/it/');
    }
  })();
</script>
